# Application settings
APP_NAME="Karnataka Electoral Notice Checker"

# CEO Karnataka Source Page URL (Configurable by Admin)
SOURCE_URL="https://ceo.karnataka.gov.in/notices_issued.html"

# Database Connection (SQLite or PostgreSQL)
# SQLite default: sqlite:///./epic_notice_checker.db
# PostgreSQL example: postgresql://user:password@localhost:5432/epic_notice_db
DATABASE_URL="sqlite:///./epic_notice_checker.db"

# Admin Portal Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Crawler & Pipeline Settings
OCR_ENABLED=true
CRAWLER_TIMEOUT=30
MAX_PDF_SIZE_MB=50
RATE_LIMIT_PER_MINUTE=60
SECRET_KEY="epic-checker-secret-key-2026"
